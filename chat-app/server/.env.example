# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-32-char-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT on Neon: use the DIRECT URL (Pooling toggle OFF) for both vars.
# The pooler URL (contains "-pooler") breaks Prisma with "prisma:error Closed".
# Pool tuning — these matter more than they look:
#   connect_timeout=15  covers Neon's scale-to-zero cold start (~1.8s measured).
#                       Without it Prisma gives up before the compute wakes.
#   connection_limit=5  Prisma defaults to cores*2+1 (13 on a 6-core box). A
#                       smaller pool means fewer sockets available to get
#                       stranded when Neon suspends, so recovery is quicker.
#   pool_timeout=20     seconds to wait for a free slot before erroring.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=5&pool_timeout=20
# Used by Prisma Migrate / db push. Must be the DIRECT (non-pooler) URL on Neon.
# Falls back to DATABASE_URL when unset.
DIRECT_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Encryption (REQUIRED in production) ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without a persistent key, encrypted messages cannot be decrypted after restart.
CHAT_ENCRYPTION_KEY=

# ── AI Classification (optional — graceful fallback if missing) ────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Upstash free tier or redis://localhost:6379 in Docker.
# Leave empty for built-in in-memory presence + rate limits (single instance).
REDIS_URL=

# ── Neon free-tier keep-alive (leave OFF) ─────────────────────────────────────
# Neon Free suspends a compute after 5 min idle and scale-to-zero cannot be
# disabled. Holding it awake 24/7 costs roughly 180 CU-hours/month against a
# 100 CU-hour quota, which suspends the whole project. A cold start costs only
# ~1.8s, so letting it sleep is the cheaper trade. Set this only if you accept
# that cost (e.g. 300000 = ping every 5 minutes).
# DB_KEEPALIVE_MS=
