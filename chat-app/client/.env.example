# Client-side environment (Vite exposes only VITE_* variables to the browser).
# Copy to .env.local for local overrides — .env.local is gitignored.

# Absolute API base. Leave EMPTY (recommended) so production uses same-origin
# requests — the Express Dockerfile serves frontend + API on one host.
# Set only for local cross-host dev, e.g. http://localhost:3001
VITE_API_URL=

# Socket.IO endpoint. Leave EMPTY to use window.location.origin
# (same rule — /socket.io must reach the API server through your proxy).
VITE_SOCKET_URL=