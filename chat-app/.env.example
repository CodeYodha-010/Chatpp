# ============================================
# Chatpp - Environment Configuration (Development)
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For production, see .env.production.example in the deploy/ folder.

# ── Application ──────────────────────────────
NODE_ENV=development
PORT=3001
# Client origin (Vite dev server). For production, set to your real domain.
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────
# Example: postgresql://user:password@localhost:5432/chatdb
# Run `npm run db:push` to sync the schema after setting this.
DATABASE_URL=postgresql://user:password@localhost:5432/chatdb?schema=public

# ── Authentication ───────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes).
CORS_ORIGIN=http://localhost:5173,https://localhost

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Password Hashing ───────────────────────
BCRYPT_ROUNDS=12

# ── Redis (optional — enables multi-instance scaling) ─
# Leave empty to use in-memory adapter (single instance only).
REDIS_URL=

# ── AI Classification (optional) ─────────────
# Get a key at https://console.groq.com/
GROQ_API_KEY=

# ── Message Encryption ───────────────────────
# 32-byte hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CHAT_ENCRYPTION_KEY=
