# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-32-char-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Encryption (REQUIRED in production) ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without a persistent key, encrypted messages cannot be decrypted after restart.
CHAT_ENCRYPTION_KEY=

# ── AI Classification (optional — graceful fallback if missing) ────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Upstash free tier or redis://localhost:6379 in Docker.
# Leave empty for built-in in-memory presence + rate limits (single instance).
REDIS_URL=
