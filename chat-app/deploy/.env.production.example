# ============================================
# Chatpp - Production Environment Template
# ============================================
# Copy to .env.production and fill with real values:
#   cp .env.production.example .env.production
#
# ── Application ──────────────────────────────
NODE_ENV=production
PORT=3001
CLIENT_URL=https://your-domain.com

# ── Database (PostgreSQL) ─────────────────────
# Use your managed PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@postgres:5432/chatdb?schema=public

# ── Authentication ───────────────────────────
# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# ── CORS ─────────────────────────────────────
# Only your production domain(s).
CORS_ORIGIN=https://your-domain.com

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Password Hashing ───────────────────────
BCRYPT_ROUNDS=12

# ── Redis (recommended for multi-instance) ───
REDIS_URL=redis://redis:6379

# ── AI Classification (optional) ─────────────
GROQ_API_KEY=

# ── Message Encryption ───────────────────────
CHAT_ENCRYPTION_KEY=
