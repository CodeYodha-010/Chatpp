generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  displayName   String?   @map("display_name")
  avatarColor   String?   @default("#3B82F6") @map("avatar_color")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  rooms       Room[]
  memberships RoomMember[]
  messages    Message[]
  sessions    Session[]
  auditLogs   AuditLog[]
  reactions   Reaction[]
  hidden      HiddenMessage[]
  cleared     ClearedConversation[]

  @@map("users")
}

model Room {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  // Direct messages are identified by their sorted participant id pair
  // ("3:7"), so the same two people always resolve to one conversation no
  // matter who starts it. NULL for public rooms and groups.
  dmKey       String?   @unique @map("dm_key")
  description String?
  type        String    @default("public")
  createdBy   Int?      @map("created_by")
  isArchived  Boolean   @default(false) @map("is_archived")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator     User?        @relation(fields: [createdBy], references: [id])
  memberships RoomMember[]
  messages    Message[]
  clearedBy   ClearedConversation[]

  @@map("rooms")
}

model RoomMember {
  roomId     Int       @map("room_id")
  userId     Int       @map("user_id")
  role       String    @default("member")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_members")
}

model Message {
  id               Int      @id @default(autoincrement())
  roomId           Int      @map("room_id")
  userId           Int?     @map("user_id")
  username         String
  encryptedContent String   @map("encrypted_content")
  iv               String
  authTag          String   @map("auth_tag")
  priority         String   @default("fyi")
  parentId         Int?     @map("parent_id")
  isEdited         Boolean  @default(false) @map("is_edited")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")

  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent Message? @relation("MessageReplies", fields: [parentId], references: [id])
  replies Message[] @relation("MessageReplies")
  reactions Reaction[]
  hiddenBy  HiddenMessage[]

  @@index([roomId, createdAt])
  @@index([priority])
  @@map("messages")
}

// One row per (user, message, emoji) — a UNIQUE constraint there makes the
// toggle a single upsert/delete and guarantees no duplicate reactions.
model Reaction {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  userId    Int      @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("reactions")
}

// Delete-for-me: one tombstone row per (user, message). Relations use
// onDelete Cascade so removing a user or message cleans up its rows.
model HiddenMessage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  messageId Int      @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@map("hidden_messages")
}

// Clear-chat-for-me: one row per (user, room). History queries exclude that
// user's messages at or before clearedAt; new messages reappear normally.
model ClearedConversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roomId    Int      @map("room_id")
  clearedAt DateTime @default(now()) @map("cleared_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@map("cleared_conversations")
}

model Session {
  id           String   @id
  userId       Int      @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     String?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}
